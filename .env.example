BASTIAPI_KEY=your_api_key_here
SESSION_SECRET=change_this_to_a_long_random_secret
# Number of trusted reverse proxies (HTTPS cookie detection). Use 0 for direct HTTP.
TRUST_PROXY=1
PORT=3000
# Optional but strongly recommended for reliable full-playlist import.
# Get one free at https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=

# Temporary completed YouTube audio cache (under the persistent ./data mount).
YOUTUBE_CACHE_MAX_MB=1024
YOUTUBE_CACHE_ENTRY_MB=128
YOUTUBE_CACHE_TTL_HOURS=6
YOUTUBE_PREFETCH_COUNT=3
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=180
# Requested videos have a separate MP4 cache; personal songs stay audio-only.
YOUTUBE_VIDEO_CACHE_MAX_MB=1024
YOUTUBE_VIDEO_CACHE_ENTRY_MB=256
