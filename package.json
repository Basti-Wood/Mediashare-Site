{
  "name": "mediashare-site",
  "version": "1.0.0",
  "description": "Mediashare website with multi-channel support and webhook integration",
  "main": "scrs/backend/server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node scrs/backend/server.js",
    "dev": "nodemon scrs/backend/server.js",
    "streamdeck:pack": "npx --yes @elgato/cli@1.10.4 pack streamdeck/com.bastiwood.mediashare.sdPlugin --output streamdeck --force --no-update-check --no-file-list"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
